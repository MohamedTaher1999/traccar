<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd"
        logicalFilePath="changelog-7.3">
    <changeSet author="author" id="changelog-7.3">
        <addColumn tableName="tc_classes">
            <column name="classid" type="INT"> <constraints nullable="false" /></column>
        </addColumn>
        <createTable tableName="tc_user_class">
            <column name="userid" type="INT">
                <constraints nullable="false" />
            </column>
            <column name="classid" type="INT">
                <constraints nullable="false" />
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="tc_user_class" baseColumnNames="classid" constraintName="fk_user_class_classid" onDelete="CASCADE" referencedColumnNames="id" referencedTableName="tc_classes" />
        <addForeignKeyConstraint baseTableName="tc_user_class" baseColumnNames="userid" constraintName="fk_user_class_userid" onDelete="CASCADE" referencedColumnNames="id" referencedTableName="tc_users" />

    </changeSet>

</databaseChangeLog>
