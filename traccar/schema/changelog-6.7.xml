<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd"
        logicalFilePath="changelog-6.6">
    <changeSet author="author" id="changelog-6.7">

        <createTable tableName="tc_classes">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(128)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="VARCHAR(4000)"/>
        </createTable>

        <!-- Add classid column to tc_user table -->
        <addColumn tableName="tc_users">
            <column name="classid" type="INT">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <!-- Add foreign key constraint -->
        <addForeignKeyConstraint
                baseTableName="tc_users"
                baseColumnNames="classid"
                constraintName="fk_user_class_id"
                referencedTableName="tc_classes"
                referencedColumnNames="id"
                onDelete="SET NULL"/>
    </changeSet>

</databaseChangeLog>
